# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---- Anthropic (listing copy generation) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- eBay ----
# From https://developer.ebay.com/my/keys — you get separate Sandbox and Production keysets.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay's redirect is identified by a "RuName", not a raw URL. Create it under
# your keyset's "User tokens" -> "Get a Token from eBay via Your Application".
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_DE

# ---- You, as the manufacturer (EU product safety / GPSR) ----
# If you print and sell the item under your own name, GPSR (EU 2023/988) makes
# you the manufacturer. Because you are in the EU you are also your own
# responsible person, so eBay wants these fields and NOT a separate EU
# representative. eBay requires them only for certain categories; the tool
# checks which, and refuses to publish into a category that needs them if they
# are blank. Leave SELLER_COMPANY_NAME empty to skip the block entirely.
SELLER_COMPANY_NAME=
SELLER_ADDRESS_LINE1=
SELLER_ADDRESS_LINE2=
SELLER_CITY=
SELLER_STATE=
SELLER_POSTAL_CODE=
SELLER_COUNTRY=DE
# At least one contact route is required.
SELLER_EMAIL=
SELLER_PHONE=
SELLER_CONTACT_URL=

# ---- Cults3D (source platform, GraphQL API) ----
# Create the API key yourself at https://cults3d.com/en/api/keys (any account
# can). Auth is HTTP Basic: base64(username:api_key) — the API refuses every
# request without it, schema introspection included. Rate limits are roughly
# 60 requests / 30 s and 500 / day.
CULTS3D_USERNAME=
CULTS3D_API_KEY=

# ---- Etsy ----
# From https://www.etsy.com/developers/your-apps
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must exactly match a redirect URI registered on the app.
ETSY_REDIRECT_URI=http://localhost:3456/callback
